---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank you — STIKR" description="Your STIKR order details are saved. We’ll take payment next.">
  <header class="ty-header">
    <div class="wrap ty-bar">
      <a class="logo" href="/" aria-label="STIKR home">
        <img src="/images/logo.png" alt="STIKR" width="219" height="38" />
      </a>
      <a class="back" href="/#pricing">Back to product</a>
    </div>
  </header>

  <main class="wrap ty">
    <div class="ty-empty" data-ty-empty hidden>
      <p class="lime display kicker">Thank you</p>
      <h1 class="display">No order found</h1>
      <p class="lead">Place an order from checkout and you’ll land here with the details.</p>
      <a class="btn" href="/checkout">Go to checkout</a>
    </div>

    <div class="ty-ok" data-ty-ok hidden>
      <p class="lime display kicker">Thank you</p>
      <h1 class="display">You’re locked in</h1>
      <p class="lead" data-ty-lead></p>

      <section class="ty-card">
        <div class="product">
          <img src="/images/product.png" alt="STIKR pouch" />
          <div>
            <p class="lime display small">Order confirmed</p>
            <h2 data-ty-id></h2>
            <p data-ty-product>STIKR magnetic gym pouch</p>
          </div>
        </div>

        <p class="price-note" data-discount-note hidden></p>

        <dl>
          <div>
            <dt>Name</dt>
            <dd data-ty-name></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd data-ty-phone></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd data-ty-email></dd>
          </div>
          <div>
            <dt>Deliver to</dt>
            <dd data-ty-address></dd>
          </div>
          <div>
            <dt>Quantity</dt>
            <dd data-ty-qty></dd>
          </div>
          <div>
            <dt>Unit price</dt>
            <dd data-ty-unit></dd>
          </div>
          <div class="total">
            <dt>Total</dt>
            <dd class="display lime" data-ty-total></dd>
          </div>
        </dl>
      </section>

      <p class="fine">No payment is taken yet. We’ll use this order when the payment API is connected.</p>

      <div class="ty-actions">
        <a class="btn" href="/">Back to STIKR</a>
        <a class="btn btn-ghost" href="/checkout">Place another order</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ty-header {
    padding: 16px 0 8px;
  }

  .ty-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 74px;
    padding: 0 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
  }

  .logo img {
    height: 38px;
    width: auto;
  }

  .back {
    color: var(--lime);
    white-space: nowrap;
  }

  .ty-empty[hidden],
  .ty-ok[hidden] {
    display: none !important;
  }

  .ty {
    padding: 48px 0 96px;
    max-width: 760px;
  }

  .kicker {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .ty h1 {
    margin: 0 0 12px;
    font-size: clamp(36px, 8vw, 56px);
  }

  .lead {
    margin: 0 0 36px;
    color: var(--muted);
  }

  .ty-card {
    background: var(--card);
    border-radius: var(--radius-lg);
    padding: 28px;
  }

  .product {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 20px;
  }

  .product img {
    width: 96px;
    height: 96px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .small {
    margin: 0 0 6px;
    font-size: 14px;
  }

  .product h2 {
    margin: 0;
    font-size: 22px;
    font-family: var(--body);
    font-style: normal;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    word-break: break-word;
  }

  .product p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  .price-note {
    margin: 0 0 16px;
    padding: 12px 14px;
    border: 1px solid var(--lime);
    border-radius: var(--radius);
    background: rgba(210, 246, 84, 0.08);
    color: var(--lime);
    font-size: 15px;
  }

  .price-note[hidden] {
    display: none;
  }

  .price-note strong {
    color: white;
  }

  dl {
    margin: 0;
  }

  dl > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
  }

  dt {
    color: var(--muted);
    flex-shrink: 0;
  }

  dd {
    margin: 0;
    text-align: right;
  }

  .total {
    font-size: 22px;
  }

  .fine {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .ty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .ty-actions .btn {
    min-height: 48px;
  }

  @media (max-width: 760px) {
    .ty-bar {
      min-height: 56px;
      padding: 0 12px;
    }

    .logo img {
      height: 24px;
    }

    .ty {
      padding: 28px 0 64px;
    }

    .ty-card {
      padding: 20px;
    }

    .product {
      align-items: flex-start;
    }

    dl > div {
      flex-direction: column;
      gap: 4px;
    }

    dd {
      text-align: left;
    }

    .ty-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { applyOfferToPage, loadOffer } from "../scripts/offer.js";

  applyOfferToPage(loadOffer());

  const empty = document.querySelector("[data-ty-empty]");
  const ok = document.querySelector("[data-ty-ok]");

  let order = null;
  try {
    order = JSON.parse(localStorage.getItem("stikr-pending-order") || "null");
  } catch {
    order = null;
  }

  if (!order?.id) {
    if (empty) empty.hidden = false;
  } else if (ok) {
    ok.hidden = false;
    const customer = order.customer || {};
    const address = [customer.address1, customer.address2, customer.city, customer.region, customer.country]
      .filter(Boolean)
      .join(", ");

    const set = (sel, value) => {
      const node = document.querySelector(sel);
      if (node) node.textContent = value;
    };

    set("[data-ty-lead]", `Thanks ${customer.name || ""}. Order ${order.id} is saved for delivery.`);
    set("[data-ty-id]", order.id);
    set("[data-ty-product]", `${order.product} × ${order.quantity}`);
    set("[data-ty-name]", customer.name || "—");
    set("[data-ty-phone]", customer.phone || "—");
    set("[data-ty-email]", customer.email || "—");
    set("[data-ty-address]", address || "—");
    set("[data-ty-qty]", String(order.quantity));
    set("[data-ty-unit]", `AED ${order.unitPrice}`);
    set("[data-ty-total]", `AED ${order.total}`);
  }
</script>
