---
import Layout from "../layouts/Layout.astro";

const benefits = [
  { img: "/images/benefit-1.png", title: "Cleaner transitions between sets", pos: "tl" },
  { img: "/images/benefit-2.png", title: "Zero interruptions mid-workout", pos: "tr" },
  { img: "/images/benefit-3.png", title: "One place for all essentials", pos: "mid" },
  { img: "/images/benefit-5.png", title: "A setup that moves as fast as you do", pos: "bl" },
  { img: "/images/benefit-4.png", title: "A workout where you stay dialed", pos: "br" },
];

const colors = [
  {
    id: "stay",
    num: "01",
    color: "#efffb7",
    img: "/images/color-stay.png",
    short: "Stay",
    title: "Stay in the zone",
    copy: "No distractions. No clutter. No stopping mid-set to find anything.",
  },
  {
    id: "move",
    num: "02",
    color: "#d2f654",
    img: "/images/benefit-3.png",
    short: "Move",
    title: "Move faster",
    copy: "Perfect for supersets, drop sets, and circuit training.",
  },
  {
    id: "keep",
    num: "03",
    color: "#b8da45",
    img: "/images/color-move.png",
    short: "Keep",
    title: "Keep everything close",
    copy: "Your essentials follow you — not the other way around.",
  },
  {
    id: "look",
    num: "04",
    color: "#93b719",
    img: "/images/color-keep.png",
    short: "Look",
    title: "Look cleaner",
    copy: "Looks athletic, intentional, disciplined.",
  },
  {
    id: "train",
    num: "05",
    color: "#638000",
    img: "/images/intro-product.png",
    short: "Train",
    title: "Train with clarity",
    copy: "A tidy space = a tidy mind = a stronger workout.",
  },
];

const quotes = [
  {
    text: "I don’t break rhythm anymore. This pouch keeps everything tight and accessible.",
    name: "Omar A",
    avatar: "/images/avatar-omar.png",
  },
  {
    text: "Perfect for supersets. Everything follows me instantly.",
    name: "Hana M.",
    avatar: "/images/avatar-hana.png",
  },
  {
    text: "The magnet is no joke. It stays locked even during heavy deadlifts.",
    name: "Talal R.",
    avatar: "/images/avatar-talal.png",
  },
  {
    text: "I train better when things are organized. This is now part of my setup.",
    name: "Raquel L.",
    avatar: "/images/avatar-raquel.png",
  },
];

const costs = [
  { problem: "Broken focus?", result: "Progress" },
  { problem: "Lost rhythm?", result: "Performance" },
  { problem: "Unorganized setup?", result: "Consistency" },
];
---

<Layout>
  <section class="hero" id="top">
    <div class="hero-media">
      <img class="hero-still" src="/images/color-stay.png" alt="" />
      <div class="hero-fade"></div>
      <div class="pills">
        <span class="pill p1">Ultra-strong magnetic grip</span>
        <span class="pill p2">Quick-access athletic design</span>
        <span class="pill p3">Stays put through any workout</span>
      </div>
    </div>

    <header class="site-header">
      <div class="header-bar">
        <a class="logo" href="#top" aria-label="STIKR home">
          <img src="/images/logo.png" alt="STIKR" width="219" height="38" />
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="#top">Home</a>
          <a href="#about">About</a>
          <a href="#features">Features</a>
          <a href="#pricing">Pricing</a>
        </nav>
        <a class="btn header-cta" href="/checkout">Buy Now</a>
        <button class="menu-toggle" type="button" aria-label="Open menu" data-menu-toggle>
          <span></span><span></span>
        </button>
      </div>
    </header>

    <div class="wrap hero-copy">
      <h1 class="display lime">
        Great workouts<br />come from<br />great focus
      </h1>
      <p>
        When you're locked in, every rep matters.
        <span class="stikr-mark"> STIK<em>R</em> </span>
        keeps your phone, keys, & headphones exactly where you need them. Now nothing breaks your rhythm, your flow, or your performance.
      </p>
      <div class="hero-actions">
        <a class="btn hero-cta" href="/checkout">Keep me locked-in</a>
        <div class="price-stack">
          <p>Retail Price: <span class="lime display price-em">AED 149</span></p>
          <p>Black Friday Sale: <span class="lime display price-em">save 10% today</span></p>
          <p><strong>GET NOW:</strong> <span class="lime display price-em">AED 134</span></p>
        </div>
      </div>
    </div>
  </section>

  <main>
    <section class="section-space" id="about">
      <div class="wrap problem-head">
        <h2 class="display">
          <span class="lime">Tired of mishandling</span> your<br />essentials during workout?
        </h2>
        <p>
          You walk into the gym ready to crush your workout. You warm up, grab a bench — and suddenly you’re dealing with the same annoying problem:
        </p>
      </div>
      <div class="wrap problem-grid">
        <article>
          <img src="/images/problem-1.png" alt="Phone, keys, wallet and AirPods on a table" />
          <h3 class="display lime">Where do you put your stuff?</h3>
          <ul>
            <li>Your mobile and keys?</li>
            <li>Your wallet?</li>
            <li>Your AirPods case?</li>
          </ul>
        </article>
        <article>
          <img src="/images/problem-2.png" alt="Phone left on the gym floor next to dumbbells" />
          <h3 class="display lime">You try</h3>
          <ul>
            <li>Balancing your phone on the bench.</li>
            <li>Putting it on the floor.</li>
            <li>Holding everything in your pockets.</li>
          </ul>
        </article>
        <article>
          <img src="/images/problem-3.png" alt="Athlete sitting in a locker room" />
          <h3 class="display lime">And lockers?</h3>
          <p>Sure — if you enjoy walking back and forth between every set.</p>
        </article>
      </div>
    </section>

    <section class="section-space intro">
      <div class="wrap intro-grid">
        <div>
          <img class="wordmark" src="/images/logo.png" alt="STIKR" width="219" height="38" />
          <p class="intro-lead">
            Keeps your essentials off the floor, out of your pockets, and always within reach — so your flow stays untouched.
          </p>
        </div>
        <img class="intro-photo" src="/images/intro-product.png" alt="STIKR holding a bottle and phone on gym equipment" />
      </div>
    </section>

    <section class="section-space">
      <div class="wrap">
        <h2 class="display">
          Let’s be real —<br />this is <span class="lime">what you want</span>
        </h2>
        <div class="benefits-stage">
          <img class="dash a6-top" src="/images/arrow-6.png" alt="" />
          <img class="dash a6-bot" src="/images/arrow-6.png" alt="" />
          <img class="dash a7" src="/images/arrow-7.png" alt="" />
          <img class="dash a8" src="/images/arrow-8.png" alt="" />
          {benefits.map((item) => (
            <article class={`benefit-card ${item.pos}`}>
              <img src={item.img} alt="" />
              <p>{item.title}</p>
            </article>
          ))}
        </div>
        <div class="benefit-foot">
          <p>
            If that sounds right…
            <span class="stikr-mark">STIK<em>R</em></span>
            {" "}is already a must-have for you.
          </p>
          <a class="btn" href="#pricing">Equip me like an athlete</a>
        </div>
      </div>
    </section>

    <section class="features" id="features" data-features>
      <div class="features-bg" style="background-image: url('/images/features-bg.png')"></div>
      <div class="feature-stage">
        <h2 class="display">
          Designed to move with you.<br />
          <span class="lime">Built for athletes</span> who don’t slow down.
        </h2>

        <img class="feature-product" src="/images/product.png" alt="STIKR pouch with water bottle" />

        <svg class="leader l1" width="290" height="55" viewBox="0 0 290 55" fill="none" aria-hidden="true">
          <path d="M290 54.5H55.5L5.5 5.5" pathLength="1" />
          <circle cx="5" cy="5" r="5" fill="#D2F654" />
          <circle cx="5" cy="5" r="3" fill="#111111" />
        </svg>
        <svg class="leader l2" width="290" height="54.5" viewBox="0 0 290 54.5" fill="none" aria-hidden="true">
          <path d="M290 0.5H55.5L5.5 49.5" pathLength="1" />
          <circle cx="5" cy="49.5" r="5" fill="#D2F654" />
          <circle cx="5" cy="49.5" r="3" fill="#111111" />
        </svg>
        <svg class="leader l3" width="124.938" height="119.241" viewBox="0 0 124.938 119.241" fill="none" aria-hidden="true">
          <path d="M124.5 0.24L75 90.241L7 113.741" pathLength="1" />
          <circle cx="5" cy="114.241" r="5" fill="#D2F654" />
          <circle cx="5" cy="114.241" r="3" fill="#111111" />
        </svg>
        <svg class="leader l4" width="124.938" height="119.241" viewBox="0 0 124.938 119.241" fill="none" aria-hidden="true">
          <path d="M124.5 0.24L75 90.241L7 113.741" pathLength="1" />
          <circle cx="5" cy="114.241" r="5" fill="#D2F654" />
          <circle cx="5" cy="114.241" r="3" fill="#111111" />
        </svg>
        <svg class="leader l5" width="290" height="54.5" viewBox="0 0 290 54.5" fill="none" aria-hidden="true">
          <path d="M290 0.5H55.5L5.5 49.5" pathLength="1" />
          <circle cx="5" cy="49.5" r="5" fill="#D2F654" />
          <circle cx="5" cy="49.5" r="3" fill="#111111" />
        </svg>
        <svg class="leader l6" width="290" height="54.5" viewBox="0 0 290 54.5" fill="none" aria-hidden="true">
          <path d="M290 0.5H55.5L5.5 49.5" pathLength="1" />
          <circle cx="5" cy="49.5" r="5" fill="#D2F654" />
          <circle cx="5" cy="49.5" r="3" fill="#111111" />
        </svg>

        <div class="callout c-magnet">
          <h3>Ultra-strong neodymium magnet</h3>
          <p>Locks onto racks, machines, dumbbell stands — stays put through heavy reps and fast transitions.</p>
        </div>
        <div class="callout c-slip">
          <h3>Anti-slip athletic backing</h3>
          <p>Sweat? Movement? Impact?<br />It doesn’t budge.</p>
        </div>
        <div class="callout c-light">
          <h3>Lightweight, minimal, athletic build</h3>
          <p>Carry less. Move better.<br />Matches every training style.</p>
        </div>
        <div class="callout c-sweat">
          <h3>Sweat-proof external material</h3>
          <p>Built for real gym conditions — not<br />gentle handling.</p>
        </div>
        <div class="callout c-quick">
          <h3>Quick-access layout</h3>
          <p>Phone, AirPods, keys — grab, drop, go.<br />Zero messing around.</p>
        </div>
        <div class="callout c-shock">
          <h3>Shock-resistant interior</h3>
          <p>Protects your phone through the intensity<br />of your workout.</p>
        </div>
      </div>
    </section>

    <section class="section-space colors">
      <div class="wrap">
        <h2 class="display">
          Small accessory.<br />Big upgrade to your <span class="lime">training</span>
        </h2>
      </div>
      <div class="color-row" data-color-row>
        {colors.map((item, index) => (
          <button
            class:list={["color-col", { "is-open": index === 4 }]}
            type="button"
            style={`--swatch:${item.color}`}
            data-color
            aria-pressed={index === 4 ? "true" : "false"}
          >
            <span class="color-fill"></span>
            <img src={item.img} alt="" />
            <span class="color-shade"></span>
            <span class="color-num display">{item.num}</span>
            <strong class="display color-short">{item.short}</strong>
            <strong class="display color-title">{item.title}</strong>
            <span class="color-copy-line">{item.copy}</span>
          </button>
        ))}
      </div>
      <div class="wrap color-copy">
        <div>
          <p>
            Imagine a workout where every machine is ready, your essentials stay aligned with your flow, and nothing breaks your momentum.
          </p>
          <p class="display give">
            That’s what STIK<span class="lime">R</span> gives you.
          </p>
        </div>
        <form class="signup" data-signup>
          <label for="email">Sign Up for a 20% additional discount now!</label>
          <div class="signup-row">
            <input id="email" name="email" type="email" required placeholder="Enter your email" />
            <button class="btn" type="submit">Sign up</button>
          </div>
          <p class="signup-msg" hidden>You’re in. We’ll send the 20% code.</p>
        </form>
      </div>
    </section>

    <section class="section-space quotes">
      <div class="wrap quotes-head">
        <h2 class="display">
          <span class="lime">Athletes</span> love the<br />difference it makes
        </h2>
        <a class="btn" href="#pricing">Join the Athletes Who Train Smarter</a>
      </div>
      <div class="wrap quotes-layout">
        <img class="quotes-photo" src="/images/testimonial-photo.png" alt="Athlete training with a flashlight-style beam overlay" />
        <div class="quote-track-wrap">
          <div class="quote-viewport" data-quote-view>
            <div class="quote-track" data-quotes>
              {quotes.map((quote) => (
                <article class="quote-card">
                  <img class="quote-mark" src="/images/quote.svg" alt="" width="80" height="52" />
                  <p>{quote.text}</p>
                  <footer>
                    <span>- {quote.name}</span>
                    <img src={quote.avatar} alt="" width="56" height="56" />
                  </footer>
                </article>
              ))}
            </div>
          </div>
          <div class="quote-nav">
            <button type="button" data-quote-prev aria-label="Previous testimonial">
              <img src="/images/carousel-prev.svg" alt="" />
            </button>
            <div class="quote-dots" data-quote-dots>
              {quotes.map((_, i) => (
                <button type="button" class:list={[{ active: i === 0 }]} aria-label={`Go to quote ${i + 1}`} data-quote-dot={i}></button>
              ))}
            </div>
            <button type="button" data-quote-next aria-label="Next testimonial">
              <img src="/images/carousel-next.svg" alt="" />
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space pricing" id="pricing">
      <div class="wrap">
        <h2 class="display">
          Level up your performance for less than the <span class="lime">price of a new gym shirt</span>
        </h2>
        <div class="pricing-grid">
          <div class="price-card">
            <div class="price-row">
              <span>Retail price</span>
              <strong class="display lime">AED 149</strong>
            </div>
            <ul>
              {costs.map((row) => (
                <li>
                  <span>
                    <img src="/images/check.svg" alt="" width="18" height="18" />
                    {row.problem}
                  </span>
                  <span class="cost-label">Costs</span>
                  <strong class="display lime">{row.result}</strong>
                </li>
              ))}
            </ul>
            <div class="price-foot">
              <span>A permanent upgrade to your training flow.</span>
              <strong class="display lime">AED 149</strong>
            </div>
            <a class="btn full" href="/checkout">Upgrade My Training Setup</a>
          </div>
          <img src="/images/product.png" alt="STIKR product" />
        </div>
      </div>
    </section>

    <section class="final-cta" id="cta">
      <div class="wrap cta-card">
        <div>
          <h2 class="display">
            Train clean.<br />Train focused.<br />Train like an athlete.
          </h2>
          <p>Your essentials stay where you train — so your mind stays on the rep, not the clutter.</p>
          <a class="cta-button" href="/checkout?offer=bf">
            <span class="timer" data-timer>00:59</span>
            I’m ready to train distraction-free
          </a>
        </div>
        <img src="/images/product.png" alt="" />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-top">
      <div>
        <img src="/images/logo.png" alt="STIKR" width="219" height="38" />
        <p>Your essentials stay where you train — so your mind stays on the rep, not the clutter.</p>
      </div>
      <nav>
        <a href="#top">home</a>
        <a href="#about">about</a>
        <a href="#features">features</a>
        <a href="#pricing">pricing</a>
      </nav>
    </div>
    <div class="wrap footer-bottom">
      <p>All rights reserved by <span class="stikr-mark">STIK<em>R</em></span></p>
      <p><a href="#">Privacy policy</a> <span>|</span> <a href="#">Terms & Conditions</a></p>
    </div>
  </footer>
</Layout>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 56.388vw;
    min-height: 640px;
    overflow: hidden;
    background: #111;
  }

  .site-header {
    position: absolute;
    top: 1.11vw;
    left: 0;
    right: 0;
    z-index: 6;
  }

  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: var(--wrap);
    height: 74px;
    margin: 0 auto;
    padding: 0 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .header-cta {
    border-radius: 8px !important;
    min-width: 140px;
    height: 48px;
  }

  .logo {
    width: 219px;
    height: 38px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .logo img {
    height: 38px;
    width: auto;
    max-width: none;
  }

  .nav {
    display: flex;
    gap: 32px;
    font-size: 18px;
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: white;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    margin: 6px 0;
    background: white;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-top: 13.96vw;
    max-width: 54.17%;
    margin-left: var(--gutter);
  }

  .hero h1 {
    font-size: 66px;
    line-height: 66px;
    margin: 0 0 40px;
  }

  .hero-copy p {
    max-width: 780px;
    margin: 0 0 36px;
    font-size: 18px;
    line-height: 28px;
  }

  .hero-actions {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-cta {
    width: 200px;
    flex-shrink: 0;
  }

  .price-stack {
    font-size: 16px;
    line-height: 24px;
  }

  .price-stack p {
    margin: 0;
  }

  .price-em {
    font-size: 16px;
    letter-spacing: 0;
  }

  .hero-media {
    position: absolute;
    top: 0;
    right: 0;
    width: 52.5%;
    height: 100%;
    overflow: hidden;
  }

  .hero-still {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-pan 14s ease-in-out infinite;
    transform-origin: 30% 60%;
  }

  @keyframes hero-pan {
    0% { transform: scale(1.04) translate(0, 0); }
    50% { transform: scale(1.14) translate(-3%, -2%); }
    100% { transform: scale(1.04) translate(0, 0); }
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #111 0%, rgba(17, 17, 17, 0) 100%);
  }

  .pills {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pill {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 300px;
    height: 48px;
    border: 1px solid var(--lime);
    color: var(--lime);
    border-radius: 50px;
    font-size: 18px;
    line-height: 28px;
    white-space: nowrap;
    background: transparent;
  }

  .p1 { left: 0.66%; top: 84.73%; transform: rotate(-8.35deg); }
  .p2 { left: 34.26%; top: 89.53%; transform: rotate(7.11deg); }
  .p3 { left: 58.73%; top: 82.14%; transform: rotate(-9.29deg); }

  .problem-head,
  .quotes-head,
  .benefit-foot,
  .color-copy,
  .pricing-grid,
  .intro-grid,
  .footer-top,
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: flex-start;
  }

  .problem-head h2,
  .quotes-head h2,
  .pricing h2,
  .colors h2 {
    font-size: 40px;
    line-height: 44px;
    margin: 0 0 24px;
  }

  .problem-head p,
  .benefit-foot p {
    max-width: 420px;
    margin: 0;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .problem-grid img,
  .intro-photo,
  .quotes-photo {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .problem-grid img {
    height: 200px;
  }

  .problem-grid h3,
  .problem-grid p,
  .problem-grid ul {
    margin: 12px 0 0;
    font-size: 18px;
  }

  .problem-grid ul {
    padding: 0;
    list-style: none;
  }

  .problem-grid li::before {
    content: "- ";
    color: var(--lime);
  }

  .intro-grid {
    align-items: center;
  }

  .intro-lead {
    font-size: 32px;
    line-height: 42px;
    max-width: 650px;
  }

  .intro-photo {
    width: 580px;
    max-width: 100%;
    height: 400px;
  }

  .wordmark {
    height: 38px;
    width: auto;
    margin-bottom: 24px;
  }

  .benefits-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1280 / 870;
    margin-top: 24px;
  }

  .benefit-card {
    position: absolute;
    width: 37.5%;
    height: 28.74%;
    background: var(--card);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .benefit-card.tl { left: 0; top: 0; }
  .benefit-card.tr { left: 53.13%; top: 0; }
  .benefit-card.mid { left: 34.92%; top: 35.63%; }
  .benefit-card.bl { left: 9.38%; top: 71.26%; }
  .benefit-card.br { left: 62.5%; top: 71.26%; }

  .benefit-card img {
    width: calc(100% - 20px);
    height: 72%;
    margin: 10px 10px 0;
    object-fit: cover;
    border-radius: 16px;
  }

  .benefit-card p {
    margin: 0;
    padding: 10px 16px 0;
    text-align: center;
    font-size: 22px;
    line-height: 32px;
  }

  .dash {
    position: absolute;
    pointer-events: none;
    z-index: 2;
