<script>
  const header = document.querySelector(".header-bar");
  document.querySelector("[data-menu-toggle]")?.addEventListener("click", () => {
    header?.classList.toggle("is-open");
  });
  header?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => header.classList.remove("is-open"));
  });

  const colorButtons = [...document.querySelectorAll("[data-color]")];
  colorButtons.forEach((button) => {
    button.addEventListener("click", () => {
      colorButtons.forEach((item) => {
        const on = item === button;
        item.classList.toggle("is-open", on);
        item.setAttribute("aria-pressed", on ? "true" : "false");
      });
    });
  });

  const form = document.querySelector("[data-signup]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const message = form.querySelector(".signup-msg");
    if (message) message.hidden = false;
    form.reset();
  });

  const features = document.querySelector("[data-features]");
  if (features && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            features.classList.add("is-on");
            io.disconnect();
          }
        });
      },
      { threshold: 0.28 },
    );
    io.observe(features);
  } else {
    features?.classList.add("is-on");
  }

  const track = document.querySelector("[data-quotes]");
  const viewport = document.querySelector("[data-quote-view]");
  const dots = [...document.querySelectorAll("[data-quote-dot]")];
  let quoteIndex = 0;
  let timerId = 0;

  const quoteStep = () => {
    const card = track?.querySelector(".quote-card");
    if (!card) return 436;
    const styles = window.getComputedStyle(track);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 16;
    return card.getBoundingClientRect().width + gap;
  };

  const goTo = (index) => {
    if (!track || !viewport) return;
    quoteIndex = (index + dots.length) % dots.length;
    const maxX = Math.max(0, track.scrollWidth - viewport.clientWidth);
    const x = Math.min(quoteIndex * quoteStep(), maxX);
    track.style.transform = `translateX(${-x}px)`;
    dots.forEach((dot, i) => dot.classList.toggle("active", i === quoteIndex));
  };

  const play = () => {
    window.clearInterval(timerId);
    timerId = window.setInterval(() => goTo(quoteIndex + 1), 4000);
  };

  document.querySelector("[data-quote-next]")?.addEventListener("click", () => {
    goTo(quoteIndex + 1);
    play();
  });
  document.querySelector("[data-quote-prev]")?.addEventListener("click", () => {
    goTo(quoteIndex - 1);
    play();
  });
  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      goTo(Number(dot.getAttribute("data-quote-dot")));
      play();
    });
  });
  play();
  window.addEventListener("resize", () => goTo(quoteIndex));

  const timer = document.querySelector("[data-timer]");
  let remaining = 59;
  setInterval(() => {
    remaining = remaining <= 0 ? 59 : remaining - 1;
    if (timer) timer.textContent = `00:${String(remaining).padStart(2, "0")}`;
  }, 1000);
</script>
