---
import "../styles/global.css";
import SpinPopup from "../components/SpinPopup.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "STIKR — Train distraction-free",
  description = "Magnetic gym pouch that keeps your phone, keys, and headphones on the machine. Black Friday: AED 119.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Oswald:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <SpinPopup />
  </body>
</html>
